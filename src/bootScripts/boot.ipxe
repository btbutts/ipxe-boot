#!ipxe

echo ========================================
echo iPXE Boot Menu - LVR Gaming PC
echo ========================================

dhcp
set syslog 10.1.10.101

set qnap-base ${178:string}

:menu
menu iPXE Boot Menu - LVR Gaming PC
item --gap -- ------------------------------
item direct        1. Network Boot Windows 11
item install       2. Install Windows 11 via Default setup.exe
item installManual 3. Install Windows 11 via DISM + BCD Script
item shell         4. iPXE Shell (Debug)
item --gap -- ------------------------------
item reboot    R. Reboot System
choose --default direct --timeout 30000 bootOption || goto cancelled

goto ${bootOption}

:direct
echo Booting Installed Windows 11 from iSCSI...
chain ${qnap-base}/iscsiChapCredential.ipxe || shell
goto menu

:install
echo ========================================
echo Starting Windows 11 Installer...
echo Using base URL: ${qnap-base}
echo Downloading install.ipxe from ${qnap-base}/install.ipxe
echo ========================================
echo
echo Press any key to CANCEL installation...
prompt --timeout 3000 || goto do_install

echo
echo Installation cancelled by the user!
goto menu

:do_install
echo
echo Launching Windows 11 Installer...
chain ${qnap-base}/iscsiChapCredential.ipxe || shell
goto menu

:installManual
echo ========================================
echo Install Windows 11 via DISM + BCD Script
echo Using base URL: ${qnap-base}
echo ========================================
echo
echo Press any key to CANCEL...
prompt --timeout 3000 || goto do_install_manual

echo
echo Installation cancelled by the user!
goto menu

:do_install_manual
echo
echo Launching DISM installer script...
chain ${qnap-base}/iscsiChapCredential.ipxe || shell
goto menu

:shell
shell
goto menu

:reboot
reboot

:cancelled
echo Menu cancelled.
exit

