#!ipxe

echo ========================================
echo Booting Windows 11 from iSCSI LUN...
echo ========================================
echo

# Credentials already set by iscsiChapCredential.ipxe

sanboot iscsi:${next-server}:::0:iqn.2004-04.us.homeenterprises:qnapts-864eu:win-lvrgamingpc || goto error

:error
echo Error: iSCSI sanboot failed! (Code: ${errno})
echo Dropping to iPXE shell for troubleshooting...
shell
