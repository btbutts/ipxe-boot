#!ipxe

# installManual.ipxe — DISM + BCD manual installation path.
# Branched from install.ipxe. Modify this file for the DISM workflow;
# install.ipxe (setup.exe path) is left untouched.

dhcp

set http-server-dhcp178 ${178:string}

echo ========================================
echo Loading Windows 11 (WinPE) DISM Installer...
echo Using server: ${next-server}
echo ========================================
echo

# ===== iSCSI Settings =====
set initiator-iqn iqn.2010-04.org.ipxe:${net0/mac:hexhyp}-%%INITIATOR_SYSNAME%%
# Credentials set by iscsiChapCredential.ipxe before this script is chained to
# ==========================

echo Initiator IQN: ${initiator-iqn}
echo Connecting to iSCSI target ${next-server}...
echo ============================================
echo

# Hook iSCSI LUN
sanhook iscsi:${next-server}:::0:%%ISCSI_IQN%% || goto error

echo iSCSI LUN hooked successfully. Booting WinPE...

# Load WinPE
kernel ${http-server-dhcp178}/wimboot
initrd ${http-server-dhcp178}/win11-install/boot/bcd BCD
initrd ${http-server-dhcp178}/win11-install/boot/boot.sdi boot.sdi
initrd ${http-server-dhcp178}/System32-Scripts/setupManual/winpeshl.ini winpeshl.ini
initrd ${http-server-dhcp178}/System32-Scripts/presetup.cmd presetup.cmd
initrd ${http-server-dhcp178}/System32-Scripts/startnet.cmd startnet.cmd
initrd ${http-server-dhcp178}/System32-Scripts/iscsi-creds.cmd iscsi-creds.cmd
initrd ${http-server-dhcp178}/System32-Scripts/setupManual/iscsi-connect.cmd iscsi-connect.cmd
initrd ${http-server-dhcp178}/System32-Scripts/setupManual/dism-install.cmd dism-install.cmd
initrd ${http-server-dhcp178}/win11-install/sources/boot.wim boot.wim

boot

:error
echo Error: iSCSI hook failed! (Code: ${errno})
echo Dropping to iPXE shell for troubleshooting...
shell
