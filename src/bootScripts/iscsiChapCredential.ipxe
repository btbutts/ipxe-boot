#!ipxe

# ===== iSCSI CHAP Credentials =====
# Placeholder values are substituted at deploy time by
# efiDeployScripts/deploy.sh — do not edit this file directly.

# CHAP: initiator authenticates TO the target
set username %%ISCSI_USER%%
set password %%ISCSI_PASS%%

# Mutual CHAP: target authenticates BACK to the initiator
set reverse-username %%IPXE_CHAP_USERNAME%%
set reverse-password %%ISCSI_CHAP_SECRET%%
# ===================================

iseq ${bootOption} direct && goto boot_direct || iseq ${bootOption} installManual && goto boot_install_manual || goto boot_install

:boot_direct
chain ${http-server-dhcp178}/direct.ipxe || goto error

:boot_install
chain ${http-server-dhcp178}/install.ipxe || goto error

:boot_install_manual
chain ${http-server-dhcp178}/installManual.ipxe || goto error

:error
echo Chain failed (bootOption: ${bootOption})
shell
