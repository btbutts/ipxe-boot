#!ipxe

# ===== iSCSI CHAP Credentials =====
# Commit this file with placeholders, then run:
#   git update-index --skip-worktree src/bootScripts/iscsiChapCredential.ipxe
# and fill in real values locally.

# CHAP: initiator authenticates TO the target
set username REPLACE_WITH_CHAP_USERNAME
set password REPLACE_WITH_CHAP_PASSWORD

# Mutual CHAP: target authenticates BACK to the initiator
set reverse-username REPLACE_WITH_MUTUAL_CHAP_USERNAME
set reverse-password REPLACE_WITH_MUTUAL_CHAP_PASSWORD
# ===================================

iseq ${bootOption} direct && goto boot_direct || goto boot_install

:boot_direct
chain ${qnap-base}/direct.ipxe || goto error

:boot_install
chain ${qnap-base}/install.ipxe || goto error

:error
echo Chain failed (option: ${bootOption})
shell
